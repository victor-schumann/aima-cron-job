# Copy to .env and fill in. Never share or commit .env.
# Your AIMA tracking link, or just the id at its end.
AIMA_TRACKING_ID=https://contactenos.aima.gov.pt/tracking/00000000-0000-0000-0000-000000000000
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_CHAT_ID=-1001234567890
# Optional: forum topic id inside a group, and a system Chromium instead of the Playwright one.
TELEGRAM_THREAD_ID=
CHROMIUM_PATH=
